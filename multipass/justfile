# Historical Resurrection-node Multipass recipes.
#
# New provisioning is intentionally blocked. Aether owns direct QEMU/KVM and
# container/kvm owns the Dockerfile-to-VM artifact conversion. Status and purge
# remain available only to inspect or remove old local instances.

base_name := "resurrection-node-base"
ubuntu := "24.04"

default:
    @echo "Multipass images are retired; use 'just kvm-build' from the repository root" >&2
    @exit 2

# Prevent legacy automation from materializing token-bearing Cloud-Init files.
render-cloud-init:
    @echo "render-cloud-init retired: use the Docker-built Aether KVM image" >&2
    @exit 2

# Refuse to create new nested-KVM hosts.
build-base:
    @echo "build-base retired: Aether runs QEMU/KVM directly" >&2
    @exit 2

# Remove the base instance (does not touch resurrection-node-N workers).
purge-base:
    multipass delete "{{ base_name }}" --purge 2>/dev/null || true

# Refuse to expand an old Multipass fleet.
clone-node N:
    @echo "clone-node {{ N }} retired: there is no supported Multipass fleet" >&2
    @exit 2

# Status of base + worker nodes.
status:
    multipass list
