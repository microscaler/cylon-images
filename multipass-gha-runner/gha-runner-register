#!/bin/bash
# Configure + install GitHub Actions runner systemd service (org-scoped).
set -euo pipefail

ORG_URL="${GHA_ORG_URL:-https://github.com/microscaler}"
RUNNER_NAME="${GHA_RUNNER_NAME:-gha-runner-1}"
RUNNER_LABELS="${GHA_RUNNER_LABELS:-microscaler,ms02}"
RUNNER_DIR="${GHA_RUNNER_DIR:-/opt/actions-runner}"
TOKEN_FILE="${GHA_TOKEN_FILE:-/etc/gha-runner/registration-token}"

if [[ ! -f "${TOKEN_FILE}" ]]; then
  echo "missing ${TOKEN_FILE}" >&2
  exit 1
fi
TOKEN="$(tr -d '[:space:]' < "${TOKEN_FILE}")"
if [[ -z "${TOKEN}" ]]; then
  echo "empty registration token in ${TOKEN_FILE}" >&2
  exit 1
fi

if [[ ! -x "${RUNNER_DIR}/config.sh" ]]; then
  echo "runner not installed under ${RUNNER_DIR}" >&2
  exit 1
fi

if [[ -f "${RUNNER_DIR}/.runner" ]]; then
  echo "runner already configured (${RUNNER_DIR}/.runner); remove with:"
  echo "  sudo -u runner ${RUNNER_DIR}/config.sh remove --token <TOKEN>"
  exit 0
fi

cd "${RUNNER_DIR}"
sudo -u runner ./config.sh --unattended \
  --url "${ORG_URL}" \
  --token "${TOKEN}" \
  --name "${RUNNER_NAME}" \
  --labels "${RUNNER_LABELS}" \
  --work _work \
  --replace

# svc.sh must run as root; installs actions.runner.<org>.<name>.service
./svc.sh install runner
./svc.sh start

if command -v shred >/dev/null 2>&1; then
  shred -u "${TOKEN_FILE}" || rm -f "${TOKEN_FILE}"
else
  rm -f "${TOKEN_FILE}"
fi

echo "registered ${RUNNER_NAME} for ${ORG_URL} labels=${RUNNER_LABELS}"
systemctl --no-pager --full status "actions.runner.*" || true
