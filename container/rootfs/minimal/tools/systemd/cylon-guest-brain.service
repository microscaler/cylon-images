[Unit]
Description=Cylon guest daemon (FAR microVM — vsock /health on 9876)
After=network-online.target vsock-hello.service
Wants=network-online.target

[Service]
Type=simple
Environment=CYLON_SKILLS_ROOT=/opt/cylon/skills
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/cylon-guest-brain
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
